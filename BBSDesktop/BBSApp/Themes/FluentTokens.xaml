<!--
  Fluent 2 tokens — compact density (Cursor-like) for AQC-Core.
  Spec: https://fluent2.microsoft.design/
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Compact spacing ramp -->
    <x:Double x:Key="SpacingNone">0</x:Double>
    <x:Double x:Key="SpacingXXS">2</x:Double>
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingS">6</x:Double>
    <x:Double x:Key="SpacingM">8</x:Double>
    <x:Double x:Key="SpacingL">12</x:Double>
    <x:Double x:Key="SpacingXL">16</x:Double>
    <x:Double x:Key="SpacingXXL">20</x:Double>
    <x:Double x:Key="SpacingXXXL">24</x:Double>
    <x:Double x:Key="PageMargin">16</x:Double>
    <x:Double x:Key="SectionGap">12</x:Double>
    <Thickness x:Key="PagePadding">16,12</Thickness>
    <Thickness x:Key="CardPadding">12,10</Thickness>
    <Thickness x:Key="CardPaddingCompact">8,6</Thickness>

    <!-- Type scale — stepped hierarchy (page → section → form → body → caption → meta) -->
    <x:Double x:Key="ControlFontSize">12</x:Double>
    <x:Double x:Key="ControlMinHeight">28</x:Double>
    <x:Double x:Key="BodyFontSize">13</x:Double>
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="MetaFontSize">11</x:Double>
    <x:Double x:Key="FormGroupFontSize">11</x:Double>
    <x:Double x:Key="SectionFontSize">14</x:Double>
    <x:Double x:Key="TitleFontSize">22</x:Double>
    <x:Double x:Key="RibbonTabFontSize">13</x:Double>
    <x:Double x:Key="RibbonCommandCaptionSize">11</x:Double>

    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">2</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">3</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">6</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">8</CornerRadius>

    <Thickness x:Key="CardStrokeThickness">1</Thickness>

    <Style x:Key="FluentCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource CardStrokeThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>

    <Style x:Key="FluentCardCompactStyle" TargetType="Border" BasedOn="{StaticResource FluentCardStyle}">
        <Setter Property="Padding" Value="{StaticResource CardPaddingCompact}"/>
    </Style>

    <Style x:Key="FluentLayerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource CardStrokeThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
    </Style>

    <!-- H1 — page title, always outside cards -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="28"/>
    </Style>

    <!-- Supporting line under page title -->
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <!-- H2 — section title, flat above content / cards -->
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SectionFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>

    <!-- H3 — form group label inside a form (flat, no chip/box) -->
    <Style x:Key="FormSectionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FormGroupFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="Margin" Value="0,12,0,4"/>
        <Setter Property="CharacterSpacing" Value="20"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="BodyStrongStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>

    <Style x:Key="MetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MetaFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="14"/>
    </Style>

    <!-- Tool-strip group labels (Elements · Draw · View) -->
    <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource MetaFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="CharacterSpacing" Value="30"/>
    </Style>

    <!-- Ribbon category tabs — active tab merges into command strip below -->
    <Style x:Key="RibbonTabStyle" TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="14,6,14,8"/>
        <Setter Property="FontSize" Value="{StaticResource RibbonTabFontSize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="Padding" Value="12,4,12,5"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="Padding" Value="12,4,12,5"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="8,2,8,3"/>
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
    </Style>

    <Style x:Key="PageRootStyle" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource PagePadding}"/>
        <Setter Property="RowSpacing" Value="{StaticResource SectionGap}"/>
        <Setter Property="ColumnSpacing" Value="{StaticResource SectionGap}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Compact default controls -->
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>

    <Style TargetType="NumberBox">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="SpinButtonPlacementMode" Value="Compact"/>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="Padding" Value="10,3,10,4"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
    </Style>

    <Style TargetType="HyperlinkButton">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style TargetType="NavigationViewItem">
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
        <Setter Property="MinHeight" Value="28"/>
    </Style>

    <Style TargetType="MenuBar">
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="{StaticResource ControlFontSize}"/>
    </Style>

    <TransitionCollection x:Key="PageContentTransitions">
        <EntranceThemeTransition FromVerticalOffset="8" IsStaggeringEnabled="False"/>
    </TransitionCollection>

    <TransitionCollection x:Key="CardContentTransitions">
        <EntranceThemeTransition FromVerticalOffset="6" IsStaggeringEnabled="True"/>
    </TransitionCollection>

    <!-- Construction element icons — light / dark SVG (see Assets/Icons/ATTRIBUTION.md) -->
    <ResourceDictionary.ThemeDictionaries>

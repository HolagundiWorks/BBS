<Application
    x:Class="BBSApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/FluentTokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Theme metric overrides for compact density -->
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
            <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
            <x:Double x:Key="TextControlThemeMinWidth">48</x:Double>
            <x:Double x:Key="ListViewItemMinHeight">28</x:Double>
            <x:Double x:Key="TreeViewItemMinHeight">28</x:Double>
            <Thickness x:Key="TextControlThemePadding">8,3,8,3</Thickness>
            <Thickness x:Key="ComboBoxPadding">8,3,8,3</Thickness>
            <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Window
    x:Class="BBSApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BOQ Core">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Caption drag region — logo + product name (Fluent title bar) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Padding="10,0,140,0"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Border Width="22" Height="22" CornerRadius="3"
                        Background="White"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/logo.png"
                           Stretch="Uniform"
                           Margin="2"
                           AutomationProperties.Name="BOQ Core logo"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock x:Name="TitleBarText"
                               Text="BOQ Core"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Human Centic Works · Hospet"
                               FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <MenuBar Grid.Row="1" Padding="6,0,6,2"
                 Height="28"
                 Background="Transparent"
                 AutomationProperties.Name="Application menu">
            <MenuBarItem Title="File" AccessKey="F">
                <MenuFlyoutItem Text="New project" Click="New_Click" AccessKey="N"/>
                <MenuFlyoutItem Text="Open…" Click="Open_Click" AccessKey="O"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Save" Click="Save_Click" AccessKey="S"/>
                <MenuFlyoutItem Text="Save as…" Click="SaveAs_Click"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Exit" Click="Exit_Click" AccessKey="X"/>
            </MenuBarItem>
            <MenuBarItem Title="View" AccessKey="V">
                <MenuFlyoutItem Text="Dashboard" Click="NavMenu_Click" Tag="dashboard"/>
                <MenuFlyoutItem Text="Levels" Click="NavMenu_Click" Tag="levels"/>
                <MenuFlyoutItem Text="Drawing takeoff" Click="NavMenu_Click" Tag="takeoff"/>
                <MenuFlyoutItem Text="Columns" Click="NavMenu_Click" Tag="columns"/>
                <MenuFlyoutItem Text="Beams" Click="NavMenu_Click" Tag="beams"/>
                <MenuFlyoutItem Text="Slabs" Click="NavMenu_Click" Tag="slabs"/>
                <MenuFlyoutItem Text="Footings" Click="NavMenu_Click" Tag="footings"/>
                <MenuFlyoutItem Text="Retaining walls" Click="NavMenu_Click" Tag="walls"/>
                <MenuFlyoutItem Text="Stairs" Click="NavMenu_Click" Tag="stairs"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Masonry walls" Click="NavMenu_Click" Tag="masonry"/>
                <MenuFlyoutItem Text="Plastering" Click="NavMenu_Click" Tag="plaster"/>
                <MenuFlyoutItem Text="PCC bed" Click="NavMenu_Click" Tag="pcc"/>
                <MenuFlyoutItem Text="Earthwork" Click="NavMenu_Click" Tag="earthwork"/>
                <MenuFlyoutItem Text="Size stone masonry" Click="NavMenu_Click" Tag="ssm"/>
                <MenuFlyoutItem Text="Shuttering" Click="NavMenu_Click" Tag="shuttering"/>
                <MenuFlyoutItem Text="Flooring" Click="NavMenu_Click" Tag="flooring"/>
                <MenuFlyoutItem Text="Painting" Click="NavMenu_Click" Tag="painting"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Purchase orders" Click="NavMenu_Click" Tag="po"/>
                <MenuFlyoutItem Text="Quantities preview" Click="NavMenu_Click" Tag="quantities"/>
                <MenuFlyoutItem Text="Report" Click="NavMenu_Click" Tag="report"/>
                <MenuFlyoutItem Text="Settings" Click="NavMenu_Click" Tag="settings"/>
            </MenuBarItem>
            <MenuBarItem Title="Help" AccessKey="H">
                <MenuFlyoutItem Text="About BOQ Core" Click="About_Click"/>
            </MenuBarItem>
        </MenuBar>

        <!-- Ribbon-style top navigation (auto-collapses after pick) -->
        <Border x:Name="RibbonChrome" Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4,12,4">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RibbonTabPanel" Orientation="Horizontal" Spacing="2"/>
                    </ScrollViewer>

                    <TextBlock x:Name="RibbonPageLabel" Grid.Column="1"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Style="{StaticResource BodyStrongStyle}"/>
                </Grid>

                <Border x:Name="RibbonBody" Grid.Row="1" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLarge}"
                        Padding="8,6" Margin="0,2,0,0">
                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RibbonCommandPanel" Orientation="Horizontal" Spacing="2"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Frame x:Name="ContentFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition/>
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>

            <!-- Fluent toast — bottom-right, acrylic tint, theme text -->
            <Border x:Name="ToastHost"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="16,16,16,72"
                    MaxWidth="400"
                    MinWidth="280"
                    Visibility="Collapsed"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Translation="0,0,32"
                    Canvas.ZIndex="200"
                    AutomationProperties.Name="Notification">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <InfoBar x:Name="ToastBar"
                         IsOpen="False"
                         IsClosable="True"
                         Background="Transparent"
                         BorderThickness="0"
                         CloseButtonClick="ToastBar_CloseClick">
                    <InfoBar.Resources>
                        <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="Transparent"/>
                        <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="Transparent"/>
                    </InfoBar.Resources>
                </InfoBar>
            </Border>

            <!-- Floating calculator: panel above FAB, bottom-right -->
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,16,16"
                        Spacing="8"
                        Canvas.ZIndex="100">
                <Border x:Name="FloatingCalcPanel"
                        Width="220"
                        Padding="10"
                        Visibility="Collapsed"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusXLarge}"
                        Translation="0,0,32"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Floating calculator">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Calculator"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Padding="4" MinWidth="28" MinHeight="28"
                                    Click="CalcClose_Click"
                                    ToolTipService.ToolTip="Close"
                                    AutomationProperties.Name="Close calculator">
                                <FontIcon Glyph="&#xE711;" FontSize="11"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                            </Button>
                        </Grid>
                        <TextBox x:Name="CalcInput"
                                 PlaceholderText="Expression"
                                 FontSize="12"
                                 MinHeight="26"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"
                                 KeyDown="CalcInput_KeyDown"
                                 TextChanged="CalcInput_TextChanged"
                                 AutomationProperties.Name="Calculator input"/>
                        <TextBox x:Name="CalcResult"
                                 PlaceholderText="Result"
                                 FontSize="12"
                                 MinHeight="26"
                                 IsReadOnly="True"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"
                                 IsTabStop="True"
                                 AutomationProperties.Name="Calculator result"/>
                        <TextBlock FontSize="9"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="Enter · Esc clear"/>
                    </StackPanel>
                </Border>

                <Button x:Name="CalcFab"
                        Width="44" Height="44"
                        Padding="0"
                        HorizontalAlignment="Right"
                        CornerRadius="22"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="CalcFab_Click"
                        ToolTipService.ToolTip="Calculator"
                        AutomationProperties.Name="Open calculator">
                    <FontIcon Glyph="&#xE8EF;" FontSize="16"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

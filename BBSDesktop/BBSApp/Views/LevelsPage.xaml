<Page
    x:Class="BBSApp.Views.LevelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Spacing="{StaticResource SectionGap}"
                    MaxWidth="960"
                    Padding="{StaticResource PagePadding}"
                    Transitions="{StaticResource PageContentTransitions}">
            <StackPanel Spacing="4">
                <TextBlock Text="Levels" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Storey heights are floor-to-floor (slab top → slab top). Column clear height ℓ = storey ht − slab thickness − beam overall depth D (IS 456)."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                <Button Content="Add storey" Style="{StaticResource PrimaryButtonStyle}" Click="Add_Click"
                        AutomationProperties.Name="Add storey"/>
                <Button Content="Remove last" Style="{StaticResource SecondaryButtonStyle}" Click="Remove_Click"
                        AutomationProperties.Name="Remove last storey"/>
                <Button Content="Apply ℓ to columns" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ApplyColumns_Click"
                        AutomationProperties.Name="Apply clear height to columns"/>
            </StackPanel>

            <InfoBar x:Name="Info" IsOpen="False"/>

            <StackPanel Spacing="4">
                <TextBlock Text="Storeys" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource FluentCardStyle}" Padding="8">
                    <ListView x:Name="LevelList" SelectionMode="None"
                              AutomationProperties.Name="Project levels">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="{StaticResource SpacingM}" Margin="0,8" MinWidth="820">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Id}" VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}"
                                             Header="Storey name" PlaceholderText="e.g. Plinth"/>
                                <NumberBox Grid.Column="2" Value="{Binding HeightMm, Mode=TwoWay}"
                                           Header="Storey ht (mm)" SpinButtonPlacementMode="Compact" Minimum="0"/>
                                <NumberBox Grid.Column="3" Value="{Binding SlabThicknessMm, Mode=TwoWay}"
                                           Header="Slab D (mm)" SpinButtonPlacementMode="Compact" Minimum="0"/>
                                <NumberBox Grid.Column="4" Value="{Binding BeamDepthMm, Mode=TwoWay}"
                                           Header="Beam D (mm)" SpinButtonPlacementMode="Compact" Minimum="0"/>
                                <StackPanel Grid.Column="5" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                    <TextBlock Text="Clear ht ℓ" Style="{StaticResource CaptionSecondaryStyle}"/>
                                    <TextBlock Text="{Binding ColumnHeightMm}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

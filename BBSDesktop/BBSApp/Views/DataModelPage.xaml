<Page
    x:Class="BBSApp.Views.DataModelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Style="{StaticResource PageRootStyle}"
          Transitions="{StaticResource PageContentTransitions}"
          RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2" MaxWidth="700" HorizontalAlignment="Left">
                <TextBlock Text="Item relationships" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Each item with its unit and rate, what feeds it (inputs — source items + materials) and what it produces (outputs — derived items). Masonry → plaster → paint; concrete → cement + aggregates."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="ViewCombo" MinWidth="150" VerticalAlignment="Center"
                          SelectionChanged="ViewCombo_SelectionChanged"
                          AutomationProperties.Name="View">
                    <ComboBoxItem Content="Items" Tag="items" IsSelected="True"/>
                    <ComboBoxItem Content="Schema diagram" Tag="diagram"/>
                </ComboBox>
                <StackPanel x:Name="DiagramTools" Orientation="Horizontal" Visibility="Collapsed"
                            Spacing="{StaticResource SpacingS}">
                    <Button Content="&#x2212;" Style="{StaticResource SecondaryButtonStyle}" MinWidth="40"
                            Click="ZoomOut_Click" AutomationProperties.Name="Zoom out"/>
                    <TextBlock x:Name="ZoomText" Text="100%" Width="52" TextAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button Content="+" Style="{StaticResource SecondaryButtonStyle}" MinWidth="40"
                            Click="ZoomIn_Click" AutomationProperties.Name="Zoom in"/>
                    <Button Content="100%" Style="{StaticResource SecondaryButtonStyle}"
                            Click="ZoomReset_Click" AutomationProperties.Name="Reset zoom to actual size"/>
                    <Button Content="Re-layout" Style="{StaticResource SecondaryButtonStyle}"
                            Click="Relayout_Click" AutomationProperties.Name="Auto-arrange the diagram"/>
                    <Button Content="Fit" Style="{StaticResource SecondaryButtonStyle}"
                            Click="Fit_Click" AutomationProperties.Name="Fit the diagram to the window"/>
                </StackPanel>
                <Button Content="Export ERD" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExportSchema_Click" AutomationProperties.Name="Export the ERD as DBML and SQL"
                        ToolTipService.ToolTip="Regenerate the logical ERD (aqc-core.dbml + .sql) for dbdiagram.io."/>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="Info" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational"/>

        <Grid Grid.Row="2">
            <Border x:Name="TableHost" Style="{StaticResource FluentCardStyle}" Padding="8"/>
            <ScrollViewer x:Name="CanvasHost" Visibility="Collapsed"
                          Margin="-16,0,-16,-12" Background="#1E2128"
                          ZoomMode="Enabled" MinZoomFactor="0.3" MaxZoomFactor="3"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </Grid>
</Page>

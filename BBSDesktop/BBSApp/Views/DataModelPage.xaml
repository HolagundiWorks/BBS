<Page
    x:Class="BBSApp.Views.DataModelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Style="{StaticResource PageRootStyle}"
          Transitions="{StaticResource PageContentTransitions}"
          RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="Item relationships (ERD)" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="How estimation items relate — item → sub-item (masonry → plaster → paint) and item → material (concrete → cement + aggregates). Drag boxes to arrange; scroll to pan; Ctrl+scroll or pinch to zoom; click an entity to highlight its links."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="ViewCombo" MinWidth="170" VerticalAlignment="Center"
                          SelectionChanged="ViewCombo_SelectionChanged"
                          AutomationProperties.Name="Relationship view">
                    <ComboBoxItem Content="Both mappings" Tag="both" IsSelected="True"/>
                    <ComboBoxItem Content="Item → sub-item" Tag="derivation"/>
                    <ComboBoxItem Content="Item → material" Tag="composition"/>
                </ComboBox>
                <Button Content="&#x2212;" Style="{StaticResource SecondaryButtonStyle}" MinWidth="40"
                        Click="ZoomOut_Click" AutomationProperties.Name="Zoom out"
                        ToolTipService.ToolTip="Zoom out"/>
                <TextBlock x:Name="ZoomText" Text="100%" Width="52" TextAlignment="Center"
                           VerticalAlignment="Center"
                           ToolTipService.ToolTip="Current zoom"/>
                <Button Content="+" Style="{StaticResource SecondaryButtonStyle}" MinWidth="40"
                        Click="ZoomIn_Click" AutomationProperties.Name="Zoom in"
                        ToolTipService.ToolTip="Zoom in"/>
                <Button Content="100%" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ZoomReset_Click" AutomationProperties.Name="Reset zoom to actual size"
                        ToolTipService.ToolTip="Actual size (100%)"/>
                <Button Content="Re-layout" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Relayout_Click" AutomationProperties.Name="Auto-arrange the diagram"/>
                <Button Content="Fit" Style="{StaticResource SecondaryButtonStyle}"
                        Click="Fit_Click" AutomationProperties.Name="Fit the diagram to the window"/>
                <Button Content="Export ERD" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExportSchema_Click" AutomationProperties.Name="Export the ERD as DBML and SQL"/>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="Info" Grid.Row="1" IsOpen="True" IsClosable="False"
                 Severity="Informational"/>

        <ScrollViewer x:Name="CanvasHost" Grid.Row="2"
                      Margin="-16,0,-16,-12"
                      Background="#1E2128"
                      ZoomMode="Enabled" MinZoomFactor="0.3" MaxZoomFactor="3"
                      HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Page>

<Page
    x:Class="BBSApp.Views.LinkRulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Style="{StaticResource PageRootStyle}"
          Transitions="{StaticResource PageContentTransitions}"
          RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="2" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="Item links" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Model linked estimation items — plaster follows masonry, paint follows plaster, skirting follows floor perimeter. Rules are saved with the project."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Add rule" Style="{StaticResource SecondaryButtonStyle}"
                        Click="AddRule_Click" AutomationProperties.Name="Add link rule"/>
                <Button Content="Reset to defaults" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ResetDefaults_Click" AutomationProperties.Name="Reset link rules to defaults"/>
                <Button Content="Export ERD" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExportSchema_Click" AutomationProperties.Name="Export the ERD as DBML and SQL"
                        ToolTipService.ToolTip="Regenerate the logical ERD (aqc-core.dbml + .sql) for dbdiagram.io from the live model."/>
                <Button Content="Export .aqcdb" Style="{StaticResource SecondaryButtonStyle}"
                        Click="ExportDb_Click" AutomationProperties.Name="Export project to SQLite database"/>
                <Button Content="Verify DB" Style="{StaticResource SecondaryButtonStyle}"
                        Click="VerifyDb_Click" AutomationProperties.Name="Verify database round-trip"/>
                <Button Content="Refresh preview" Style="{StaticResource PrimaryButtonStyle}"
                        Click="RefreshPreview_Click" AutomationProperties.Name="Refresh derivation preview"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource FluentCardCompactStyle}">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="RuleCombo" Header="Rule" HorizontalAlignment="Stretch"
                              SelectionChanged="RuleCombo_SelectionChanged"
                              AutomationProperties.Name="Rule to edit"/>
                    <ToggleSwitch x:Name="EnabledToggle" Grid.Column="1" Header="Enabled"
                                  OnContent="On" OffContent="Off" VerticalAlignment="Bottom"/>
                    <CheckBox x:Name="PerItemCheck" Grid.Column="2" Content="Per item"
                              VerticalAlignment="Bottom" Margin="4,0,0,6"
                              ToolTipService.ToolTip="One linked line per source item (keeps mark/level). Off = one aggregate line."/>
                </Grid>

                <TextBox x:Name="NameBox" Header="Rule name"
                         PlaceholderText="e.g. Plaster from masonry (both faces)"/>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SourceCombo" Header="Source trade" HorizontalAlignment="Stretch"/>
                    <ComboBox x:Name="TargetCombo" Grid.Column="1" Header="Target trade" HorizontalAlignment="Stretch"/>
                    <ComboBox x:Name="BasisCombo" Grid.Column="2" Header="Basis" HorizontalAlignment="Stretch"
                              SelectionChanged="BasisCombo_SelectionChanged"/>
                    <NumberBox x:Name="FactorBox" Grid.Column="3" Header="Factor"
                               SpinButtonPlacementMode="Compact" Minimum="0" SmallChange="0.1"
                               AutomationProperties.Name="Multiplier factor"/>
                    <TextBox x:Name="UnitBox" Grid.Column="4" Header="Unit"/>
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NotesBox" Header="Notes"
                             PlaceholderText="Optional — assumptions, IS-code reference, when to enable"/>
                    <TextBox x:Name="RateCodeBox" Grid.Column="1" Header="Rate code (optional)"
                             PlaceholderText="e.g. PL-STD"
                             ToolTipService.ToolTip="Pin the rate code the derived lines price on. Leave blank to use the target trade's default code."/>
                    <NumberBox x:Name="RateBox" Grid.Column="2" Header="Rate ₹ (optional)"
                               SpinButtonPlacementMode="Compact" Minimum="0" SmallChange="1"
                               AutomationProperties.Name="Manual unit rate"
                               ToolTipService.ToolTip="Manual unit rate for the derived lines. When set, it overrides the rate-book lookup."/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                    <Button Content="Apply changes" Style="{StaticResource SecondaryButtonStyle}"
                            Click="ApplyRule_Click"/>
                    <Button Content="Delete rule" Style="{StaticResource SecondaryButtonStyle}"
                            Click="DeleteRule_Click"/>
                    <TextBlock x:Name="EquationText" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <InfoBar x:Name="Info" Grid.Row="2" IsOpen="False"/>

        <Pivot Grid.Row="3" x:Name="MainPivot">
            <PivotItem Header="Rules">
                <Border Style="{StaticResource FluentCardStyle}" Padding="8">
                    <Border x:Name="RulesHost"/>
                </Border>
            </PivotItem>
            <PivotItem Header="Derivation preview">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                        <Button Content="Apply to sheets" Style="{StaticResource PrimaryButtonStyle}"
                                Click="ApplyToSheets_Click"
                                AutomationProperties.Name="Apply linked items to take-off sheets"/>
                        <Button Content="Clear applied" Style="{StaticResource SecondaryButtonStyle}"
                                Click="ClearApplied_Click"
                                AutomationProperties.Name="Clear applied linked items"/>
                        <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                                   Text="Writes derived rows into the take-off so they flow into BOQ &amp; estimate."/>
                    </StackPanel>
                    <TextBlock x:Name="TotalsText" Grid.Row="1" TextWrapping="Wrap" Opacity="0.85"/>
                    <Border Grid.Row="2" Style="{StaticResource FluentCardStyle}" Padding="8">
                        <Border x:Name="PreviewHost"/>
                    </Border>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>

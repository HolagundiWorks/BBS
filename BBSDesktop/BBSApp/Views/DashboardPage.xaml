<Page
    x:Class="BBSApp.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer>
        <StackPanel Spacing="20"
                    MaxWidth="760"
                    Padding="{StaticResource PagePadding}"
                    Transitions="{StaticResource PageContentTransitions}">

            <!-- Brand block — H1 -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="56" Height="56" CornerRadius="6"
                        Background="White"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Top">
                    <Image Source="ms-appx:///Assets/logo.png" Stretch="Uniform" Margin="5"
                           AutomationProperties.Name="BOQ Core logo"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="BOQ Core" Style="{StaticResource PageTitleStyle}"/>
                    <TextBlock Text="RCC BBS, civil BOQ, shuttering &amp; PDF drawing takeoff"
                               Style="{StaticResource PageSubtitleStyle}"/>
                    <TextBlock Text="Developed by Human Centic Works, Hospet"
                               Style="{StaticResource MetaTextStyle}"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock Text="Current project" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock x:Name="NameText" Style="{StaticResource BodyStrongStyle}" Margin="0"/>
                <TextBlock x:Name="CountsText" Style="{StaticResource CaptionSecondaryStyle}"/>
            </StackPanel>

            <StackPanel Spacing="4" Transitions="{StaticResource CardContentTransitions}">
                <TextBlock Text="Latest steel summary" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource CaptionSecondaryStyle}"
                           Text="Generate on an element page or open Purchase orders for full material totals."/>
                <Border Style="{StaticResource FluentCardStyle}" Padding="8" Margin="0,2,0,0">
                    <ListView x:Name="SummaryList" SelectionMode="None"
                              AutomationProperties.Name="Latest steel summary"/>
                </Border>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Drawing takeoff" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                           Text="Project → Drawing takeoff: import a PDF, set scale, measure, then Commit to BOQ. Formwork is auto from RCC. Yields and beam–slab deduct are under Settings. Open Quantities for a concrete / formwork / steel preview."/>
            </StackPanel>

            <TextBlock Style="{StaticResource MetaTextStyle}"
                       Text="© Human Centic Works, Hospet"/>
        </StackPanel>
    </ScrollViewer>
</Page>
